+    case "wand":return <><path d="M174 169l24-32" stroke="#fff5c1" strokeWidth="5"/><path d="M199 127l4 5 7 1-5 4 1 7-7-3-5 3 1-7-5-4 7-1Z" fill="#ff91d9" strokeWidth="3"/></>;
