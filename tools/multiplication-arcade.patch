@@ -0,0 +1,32 @@
+import React, { useState } from "react";
+import { catalog } from "../engine/rewards";
+import type { Hero, Item, Wardrobe as WardrobeState } from "../engine/rewards";
+import { ArcadeHero, heroNames } from "../ui/ArcadeHero";
+import { Button } from "../ui/Button";
+
+export function Wardrobe({state,onHero,onEquip,onBack}:{state:WardrobeState;onHero:(hero:Hero)=>void;onEquip:(item:Item)=>void;onBack:()=>void}){
+  const [preview,setPreview]=useState<Item|null>(null);
+  const outfit=state.outfits[state.hero];
+  const wearing=preview?{...outfit,[preview.slot]:preview.id}:outfit;
+  return <>
+    <div className="topbar"><h1 className="h1">הדמות והחנות</h1><Button variant="ghost" onClick={onBack}>חזרה למשחקים</Button></div>
+    <section className="hero-panel">
+      <div className="hero-stage"><ArcadeHero hero={state.hero} outfit={wearing}/><strong>{heroNames[state.hero]}</strong><span aria-live="polite">{preview?`תצוגה מקדימה: ${preview.name}`:"הדמות שלך"}</span></div>
+      <div>
+        <h2>מי משחק איתך?</h2>
+        <div className="hero-choices">{(["robot","fox"] as const).map(hero=><button key={hero} className="hero-choice" aria-pressed={state.hero===hero} onClick={()=>{onHero(hero);setPreview(null);}}><ArcadeHero hero={hero}/><strong>{heroNames[hero]}</strong><span>{hero==="robot"?"רובוט הכפל":"שועל הרפתקן"}</span></button>)}</div>
+        <p className="credit-badge" aria-live="polite">קרדיטים: {state.credits}</p>
+      </div>
+    </section>
+    <h2>חנות המתנות</h2>
+    {!state.earned?<p className="shop-note">החנות נפתחת אחרי משחקון שהסתיים בדיוק של יותר מ־70%. ב־95% ומעלה מרוויחים שני קרדיטים.</p>:<p className="shop-note">בחר פריט לתצוגה מקדימה. פריטים שקנית זמינים לשתי הדמויות.</p>}
+    <div className="shop-grid">{catalog.map(item=>{
+      const owned=state.owned.includes(item.id), equipped=outfit[item.slot]===item.id;
+      return <article className="shop-card" key={item.id}>
+        <strong>{item.name}</strong><span>{equipped?"על הדמות":owned?"באוסף שלך":`${item.cost} ${item.cost===1?"קרדיט":"קרדיטים"}`}</span>
+        <Button variant="ghost" aria-pressed={preview?.id===item.id} onClick={()=>setPreview(preview?.id===item.id?null:item)}>תצוגה מקדימה</Button>
+        <Button disabled={!owned&&state.credits<item.cost} onClick={()=>{onEquip(item);setPreview(null);}}>{equipped?"הסר":owned?"לבש":state.credits<item.cost?"חסרים קרדיטים":"קנה והלבש"}</Button>
+      </article>;
+    })}</div>
+  </>;
+}
