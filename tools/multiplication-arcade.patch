+import React from "react";
+import { catalog } from "../engine/rewards";
+import { BackGear, ChestGear, FaceGear, HandGear, HeadGear, SkinDecal } from "./HeroGear";
+import type { Hero, Outfit } from "../engine/rewards";
+
+export const heroNames:Record<Hero,string>={robot:"פיקסל",fox:"ניצוץ"};
+export function ArcadeHero({hero,outfit={}}:{hero:Hero;outfit?:Outfit}){
+  const robot=hero==="robot";
+  const skin=catalog.find(item=>item.slot==="skin"&&item.id===outfit.skin);
+  const [main,dark,accent]=skin&&"palette" in skin?skin.palette:robot?["#39dbe5","#2187b5","#d8ffff"]:["#ff9e45","#d85d31","#fff1c9"];
+  return <svg className="arcade-hero-art" viewBox="0 0 240 230" role="img" aria-label={heroNames[hero]}>
+    <circle cx="120" cy="108" r="88" fill="#272853"/><circle cx="120" cy="108" r="75" fill="none" stroke="#6265a7" strokeWidth="2" strokeDasharray="6 8"/>
+    <path d="M27 108h17m-8-8v16m159 25h16m-8-8v16M172 33h12m-6-6v12" stroke="#ffe17b" strokeWidth="4" strokeLinecap="round"/>
+    <SkinDecal skin={outfit.skin} color={accent}/>
+    <ellipse cx="120" cy="207" rx="74" ry="11" fill="#080a1e" opacity=".65"/>
+    <g stroke="#111530" strokeWidth="5" strokeLinejoin="round" strokeLinecap="round">
+      <BackGear id={outfit.back}/>
+      {!robot&&<path d="M150 171Q187 176 198 139Q223 177 196 199Q177 213 151 194Z" fill={main}/>}
+      {!robot&&<path d="M198 139Q214 159 207 180L188 169Q194 157 198 139Z" fill="#fff1c9"/>}
+      <path d="M89 173l-14 25q-2 8 10 8h24l7-25m13 0 5 25h25q11 0 6-10l-11-24" fill={dark}/>
+      <path d="M81 147q-23-8-30 17q-3 11 8 14q13 4 24-12m74-17q16-17 29-4q10 11-2 21l-19 10" fill={main}/>
+      <path d="M83 144q39-19 75 0l7 34q-46 18-89 0Z" fill={main}/>
+      <path d="M89 159h62l6 17q-35 13-73 0Z" fill={dark} stroke="none"/>
+      {robot?<><path d="M120 60l-2-23" fill="none"/><circle cx="118" cy="31" r="9" fill="#ffe071"/>
+        <rect x="52" y="88" width="24" height="35" rx="9" fill={dark}/><rect x="165" y="88" width="24" height="35" rx="9" fill={dark}/>
+        <path d="M72 70Q77 59 92 58h58q17 2 22 16l6 50q0 17-18 21H82q-20-2-20-19Z" fill={main}/>
+        <path d="M81 80h78q8 0 9 10l2 30q0 11-11 12H83q-10 0-10-11l2-30q1-11 6-11Z" fill="#22274c"/>
+        <path d="M93 106l8-7 8 7m20 0 8-7 8 7m-37 10q11 12 24 0" fill="none" stroke="#aaffd8" strokeWidth="5"/>
+        <path d="M83 70h38" stroke={accent} strokeWidth="4"/>
+      </>:<><path d="M65 92L59 43q0-8 8-4l44 32m22-1 40-31q9-5 8 6l-7 52" fill={main}/>
+        <path d="M72 79l-5-29 32 26m46-1 28-25-6 33" fill="#ff99a0" strokeWidth="3"/>
+        <path d="M63 92q13-25 43-24l11-9 12 10q35-1 47 22l13 26-17 1 7 10-21 0q-12 23-38 24q-28 0-41-22l-18 0 6-10-17-2Z" fill={main}/>
+        <path d="M59 115q37-14 60 15q25-27 61-14l-14 16q-23 17-47 19q-34-5-52-24Z" fill={accent} stroke="none"/>
+        <path d="M89 102l8 5 8-7m27 0 8 7 8-5" fill="none" strokeWidth="5"/>
+        <path d="M112 120q8-6 15 0l-8 7Z" fill="#151934"/><path d="M120 128q7 6 13 0" fill="none" strokeWidth="3"/>
+      </>}
+      <ChestGear id={outfit.chest}/>
+      <FaceGear id={outfit.face}/>
+      <HeadGear id={outfit.head}/>
+      <HandGear id={outfit.hand}/>
+    </g>
+  </svg>;
+}
