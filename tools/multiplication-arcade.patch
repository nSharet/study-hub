@@ -0,0 +1,98 @@
+export type Hero = "robot" | "fox";
+export type GiftKind = "skin" | "accessory";
+export type GiftId = `${GiftKind}-${number}`;
+
+export const catalog = [
+  { id:"neon", name:"סקין ניאון", slot:"skin", cost:5, palette:["#9bff62","#278841","#e8ffab"] },
+  { id:"galaxy", name:"סקין גלקסיה", slot:"skin", cost:12, palette:["#ac79fa","#543ab4","#ffe18c"] },
+  { id:"lava", name:"סקין לבה", slot:"skin", cost:8, palette:["#ff7542","#a52c38","#ffdf7d"] },
+  { id:"frost", name:"סקין קרח", slot:"skin", cost:8, palette:["#99edff","#437ec2","#f1ffff"] },
+  { id:"jungle", name:"סקין ג׳ונגל", slot:"skin", cost:5, palette:["#75cc77","#256d55","#ddff87"] },
+  { id:"candy", name:"סקין ממתקים", slot:"skin", cost:5, palette:["#ff9dd9","#b94fa6","#fff6db"] },
+  { id:"ocean", name:"סקין מעמקים", slot:"skin", cost:8, palette:["#60c5fa","#2a4bad","#a8fff3"] },
+  { id:"sunset", name:"סקין שקיעה", slot:"skin", cost:5, palette:["#ffc063","#b8488b","#fff49a"] },
+  { id:"stealth", name:"סקין נינג׳ת לילה", slot:"skin", cost:12, palette:["#777892","#343350","#ff587e"] },
+  { id:"gold", name:"סקין זהב מלכותי", slot:"skin", cost:12, palette:["#ffe174","#a66a35","#fff7c6"] },
+  { id:"crown", name:"כתר האלופים", slot:"head", cost:3 },
+  { id:"cap", name:"כובע סקייטר", slot:"head", cost:1 },
+  { id:"halo", name:"הילה זוהרת", slot:"head", cost:2 },
+  { id:"helmet", name:"קסדת אסטרונאוט", slot:"head", cost:3 },
+  { id:"visor", name:"משקפי לייזר", slot:"face", cost:3 },
+  { id:"shades", name:"משקפי שמש", slot:"face", cost:1 },
+  { id:"goggles", name:"משקפי טייס", slot:"face", cost:2 },
+  { id:"mask", name:"מסכת גיבור", slot:"face", cost:2 },
+  { id:"cape", name:"גלימת ברק", slot:"back", cost:3 },
+  { id:"wings", name:"כנפי מכונה", slot:"back", cost:3 },
+  { id:"jetpack", name:"תרמיל טילים", slot:"back", cost:3 },
+  { id:"scarf", name:"צעיף רוח", slot:"back", cost:1 },
+  { id:"badge", name:"סמל הכפל", slot:"chest", cost:1 },
+  { id:"medal", name:"מדליית הזהב", slot:"chest", cost:2 },
+  { id:"bow", name:"עניבת פרפר", slot:"chest", cost:1 },
+  { id:"gem", name:"גביש כוח", slot:"chest", cost:2 },
+  { id:"shield", name:"מגן כוכב", slot:"hand", cost:2 },
+  { id:"wand", name:"שרביט ניצוצות", slot:"hand", cost:2 },
+  { id:"pad", name:"שלט ארקייד", slot:"hand", cost:1 },
+  { id:"balloon", name:"בלון חלל", slot:"hand", cost:1 },
+] as const;
+export type Item = typeof catalog[number];
+export type Outfit = Partial<Record<Item["slot"], Item["id"]>>;
+export type Gift = { id:GiftId; kind:GiftKind; number:number; item:Item["id"]; cost:Item["cost"] };
+export type Wardrobe = { hero:Hero; credits:number; earned:number; owned:Item["id"][]; outfits:Record<Hero,Outfit>; gifts:Gift[] };
+const KEY="mul_arcade_wardrobe_v1";
+export const CREDIT_MIN_ACCURACY=75;
+export const DOUBLE_CREDIT_MIN_ACCURACY=95;
+const itemKind=(item:Item):GiftKind=>item.slot==="skin"?"skin":"accessory";
+
+function dealGifts():Gift[]{
+  return (["skin","accessory"] as const).flatMap(kind=>{
+    const items=catalog.filter(item=>itemKind(item)===kind);
+    for(let i=items.length-1;i>0;i--){
+      const j=Math.floor(Math.random()*(i+1));
+      [items[i],items[j]]=[items[j],items[i]];
+    }
+    return items.map((item,i)=>({id:`${kind}-${i+1}`,kind,number:i+1,item:item.id,cost:item.cost}));
+  });
+}
+export const emptyWardrobe=():Wardrobe=>({hero:"robot",credits:0,earned:0,owned:[],outfits:{robot:{},fox:{}},gifts:dealGifts()});
+function restoreGifts(data:unknown,fallback:Gift[]):Gift[]{
+  if(!Array.isArray(data)||data.length!==catalog.length)return fallback;
+  const byId=new Map(data.filter(g=>g&&typeof g.id==="string").map(g=>[g.id,g.item]));
+  const used=new Set<string>();
+  const gifts:Gift[]=[];
+  for(const gift of fallback){
+    const item=catalog.find(i=>i.id===byId.get(gift.id)&&itemKind(i)===gift.kind);
+    if(!item||used.has(item.id))return fallback;
+    used.add(item.id);gifts.push({...gift,item:item.id,cost:item.cost});
+  }
+  return gifts;
+}
+export function roundCredits(accuracy:number):number {
+  return !Number.isFinite(accuracy)||accuracy>100 ? 0 : accuracy>=DOUBLE_CREDIT_MIN_ACCURACY ? 2 : accuracy>=CREDIT_MIN_ACCURACY ? 1 : 0;
+}
+export function loadWardrobe():Wardrobe {
+  const initial=emptyWardrobe();
+  try{
+    const s=JSON.parse(localStorage.getItem(KEY)||"null");
+    if(!s||!Number.isSafeInteger(s.credits)||s.credits<0||!Number.isSafeInteger(s.earned)||s.earned<s.credits)return initial;
+    const owned=catalog.filter(i=>Array.isArray(s.owned)&&s.owned.includes(i.id)).map(i=>i.id);
+    const outfits=initial.outfits;
+    for(const hero of ["robot","fox"] as const)
+      for(const item of catalog)
+        if(owned.includes(item.id)&&s.outfits?.[hero]?.[item.slot]===item.id)outfits[hero][item.slot]=item.id;
+    return {hero:s.hero==="fox"?"fox":"robot",credits:s.credits,earned:s.earned,owned,outfits,gifts:restoreGifts(s.gifts,initial.gifts)};
+  }catch{return initial;}
+}
+export function saveWardrobe(s:Wardrobe){try{localStorage.setItem(KEY,JSON.stringify(s));}catch{/* Play remains available. */}}
+
+export function openGift(s:Wardrobe,id:GiftId):Wardrobe {
+  const gift=s.gifts.find(g=>g.id===id);
+  if(!gift||s.owned.includes(gift.item)||s.credits<gift.cost)return s;
+  return {...s,credits:s.credits-gift.cost,owned:[...s.owned,gift.item]};
+}
+export function equipOwned(s:Wardrobe,item:Item):Wardrobe {
+  if(!s.owned.includes(item.id))return s;
+  const outfit={...s.outfits[s.hero]};
+  if(outfit[item.slot]===item.id)delete outfit[item.slot];
+  else outfit[item.slot]=item.id;
+  return {...s,outfits:{...s.outfits,[s.hero]:outfit}};
+}
diff --git a/multiplication-arcade/src/engine/useGameClock.ts b/multiplication-arcade/src/engine/useGameClock.ts
new file mode 100644
index 0000000..6d84e00
--- /dev/null
+++ b/multiplication-arcade/src/engine/useGameClock.ts
@@ -0,0 +1,12 @@
+import { useEffect, useLayoutEffect, useRef } from "react";
+import { nowMs } from "./time";
+
+export function useGameClock(active:boolean,onTick:(now:number)=>void){
+  const latest=useRef(onTick);
+  useLayoutEffect(()=>{latest.current=onTick;});
+  useEffect(()=>{
+    if(!active)return;
+    const timer=window.setInterval(()=>latest.current(nowMs()),50);
+    return ()=>window.clearInterval(timer);
+  },[active]);
+}
