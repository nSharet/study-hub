+      <p>המתנה נפתחה!</p><h2 id="gift-reveal-title">{revealed.name}</h2>
+      <p>הפריט נוסף לאוסף שלך.</p>
+      <div className="gift-switch"><Button onClick={()=>{onEquip(revealed);closeReveal();}}>לבש עכשיו</Button><Button variant="ghost" onClick={closeReveal}>המשך לחנות</Button></div>
+    </dialog>}
+  </>;
+}
