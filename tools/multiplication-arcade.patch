+++ b/multiplication-arcade/src/ui/RoundReward.tsx
@@ -0,0 +1,11 @@
+import React,{createContext,useRef} from "react";
+
+export const RoundRewardContext=createContext<{award:(credits:number)=>void;shop:()=>void}|null>(null);
+export function RoundReward({onEarn,onShop,children}:{onEarn:(credits:number)=>void;onShop:()=>void;children:React.ReactNode}){
+  const awarded=useRef(false);
+  return <RoundRewardContext.Provider value={{award(credits){
+    if(!credits||awarded.current)return;
+    awarded.current=true;
+    onEarn(credits);
+  },shop:onShop}}>{children}</RoundRewardContext.Provider>;
+}
