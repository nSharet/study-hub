diff --git a/multiplication-arcade/src/engine/rewards.ts b/multiplication-arcade/src/engine/rewards.ts
new file mode 100644
index 0000000..29e4ec2
--- /dev/null
+++ b/multiplication-arcade/src/engine/rewards.ts
@@ -0,0 +1,40 @@
+export type Hero = "robot" | "fox";
+export const catalog = [
+  { id:"crown", name:"כתר האלופים", slot:"head", cost:1 },
+  { id:"visor", name:"משקפי לייזר", slot:"face", cost:1 },
+  { id:"cape", name:"גלימת ברק", slot:"back", cost:1 },
+  { id:"badge", name:"סמל הכפל", slot:"chest", cost:1 },
+  { id:"neon", name:"סקין ניאון", slot:"skin", cost:2 },
+  { id:"galaxy", name:"סקין גלקסיה", slot:"skin", cost:2 },
+] as const;
+export type Item = typeof catalog[number];
+export type Outfit = Partial<Record<Item["slot"], Item["id"]>>;
+export type Wardrobe = { hero:Hero; credits:number; earned:number; owned:Item["id"][]; outfits:Record<Hero,Outfit> };
+const KEY="mul_arcade_wardrobe_v1";
+export const emptyWardrobe=():Wardrobe=>({hero:"robot",credits:0,earned:0,owned:[],outfits:{robot:{},fox:{}}});
+
+export function roundCredits(accuracy:number):number {
+  return !Number.isFinite(accuracy)||accuracy>100 ? 0 : accuracy>=95 ? 2 : accuracy>70 ? 1 : 0;
+}
+export function loadWardrobe():Wardrobe {
+  const initial=emptyWardrobe();
+  try{
+    const s=JSON.parse(localStorage.getItem(KEY)||"null");
+    if(!s||!Number.isSafeInteger(s.credits)||s.credits<0||!Number.isSafeInteger(s.earned)||s.earned<s.credits)return initial;
+    const owned=catalog.filter(i=>Array.isArray(s.owned)&&s.owned.includes(i.id)).map(i=>i.id);
+    const outfits=initial.outfits;
+    for(const hero of ["robot","fox"] as const)
+      for(const item of catalog)
+        if(owned.includes(item.id)&&s.outfits?.[hero]?.[item.slot]===item.id)outfits[hero][item.slot]=item.id;
+    return {hero:s.hero==="fox"?"fox":"robot",credits:s.credits,earned:s.earned,owned,outfits};
+  }catch{return initial;}
+}
+export function saveWardrobe(s:Wardrobe){try{localStorage.setItem(KEY,JSON.stringify(s));}catch{/* Play remains available. */}}
+export function buyOrEquip(s:Wardrobe,item:Item):Wardrobe {
+  const owned=s.owned.includes(item.id);
+  if(!owned&&s.credits<item.cost)return s;
+  const outfit={...s.outfits[s.hero]};
+  if(outfit[item.slot]===item.id)delete outfit[item.slot];
+  else outfit[item.slot]=item.id;
+  return {...s,credits:s.credits-(owned?0:item.cost),owned:owned?s.owned:[...s.owned,item.id],outfits:{...s.outfits,[s.hero]:outfit}};
+}
diff --git a/multiplication-arcade/src/engine/useGameClock.ts b/multiplication-arcade/src/engine/useGameClock.ts
new file mode 100644
index 0000000..6d84e00
--- /dev/null
+++ b/multiplication-arcade/src/engine/useGameClock.ts
@@ -0,0 +1,12 @@
+import { useEffect, useLayoutEffect, useRef } from "react";
+import { nowMs } from "./time";
+
+export function useGameClock(active:boolean,onTick:(now:number)=>void){
+  const latest=useRef(onTick);
+  useLayoutEffect(()=>{latest.current=onTick;});
+  useEffect(()=>{
+    if(!active)return;
+    const timer=window.setInterval(()=>latest.current(nowMs()),50);
+    return ()=>window.clearInterval(timer);
+  },[active]);
+}
