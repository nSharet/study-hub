+import React, { useEffect, useRef, useState } from "react";
+import { catalog, CREDIT_MIN_ACCURACY, DOUBLE_CREDIT_MIN_ACCURACY } from "../engine/rewards";
+import type { GiftId, GiftKind, Hero, Item, Wardrobe as WardrobeState } from "../engine/rewards";
+import { ArcadeHero, heroNames } from "../ui/ArcadeHero";
+import { Button } from "../ui/Button";
+
+const creditText=(n:number)=>n===1?"קרדיט אחד":`${n} קרדיטים`;
+function GiftArt({kind}:{kind:GiftKind}){
+  return <svg viewBox="0 0 72 68" width="64" height="60" aria-hidden="true">
+    <g stroke="#211e43" strokeWidth="3" strokeLinejoin="round">
+      <path d="M10 30h52v30H10z" fill={kind==="skin"?"#7854e6":"#2bb7bb"}/>
+      <path d="M7 24h58v12H7z" fill={kind==="skin"?"#a389ff":"#72f4df"}/>
+      <path d="M31 24h10v36H31z" fill="#ffd46f"/>
+      <path d="M36 24C4 24 16-2 36 24C56-2 68 24 36 24Z" fill="#ffeaa8"/>
+    </g>
+    <path d="M4 10h8M8 6v8m52 37h8m-4-4v8" stroke="#ffeaa8" strokeWidth="2" strokeLinecap="round"/>
+  </svg>;
+}
+export function Wardrobe({state,onHero,onOpen,onEquip,onBack}:{state:WardrobeState;onHero:(hero:Hero)=>void;onOpen:(id:GiftId)=>void;onEquip:(item:Item)=>void;onBack:()=>void}){
+  const [kind,setKind]=useState<GiftKind>("accessory");
+  const [view,setView]=useState<"gifts"|"collection">("gifts");
+  const [selected,setSelected]=useState<GiftId|null>(null);
+  const [notice,setNotice]=useState("");
+  const dialog=useRef<HTMLDialogElement>(null);
+  const opened=state.gifts.find(g=>g.id===selected&&state.owned.includes(g.item));
+  const revealed=opened&&catalog.find(item=>item.id===opened.item);
+  const outfit=state.outfits[state.hero];
+  const gifts=state.gifts.filter(g=>!state.owned.includes(g.item));
+  const collection=catalog.filter(i=>state.owned.includes(i.id));
+  useEffect(()=>{
+    if(revealed&&dialog.current&&!dialog.current.open)dialog.current.showModal();
+  },[revealed]);
+  function closeReveal(){dialog.current?.close();setSelected(null);}
+  return <>
+    <div className="topbar"><h1 className="h1">הדמות והחנות</h1><Button variant="ghost" onClick={onBack}>חזרה למשחקים</Button></div>
+    <section className="hero-panel">
+      <div className="hero-stage"><ArcadeHero hero={state.hero} outfit={outfit}/><strong>{heroNames[state.hero]}</strong><span>הדמות שלך</span></div>
+      <div>
+        <h2>מי משחק איתך?</h2>
+        <div className="hero-choices">{(["robot","fox"] as const).map(hero=><button key={hero} className="hero-choice" aria-pressed={state.hero===hero} onClick={()=>onHero(hero)}><ArcadeHero hero={hero}/><strong>{heroNames[hero]}</strong><span>{hero==="robot"?"רובוט הכפל":"שועל הרפתקן"}</span></button>)}</div>
+        <p className="credit-badge" aria-live="polite">קרדיטים: {state.credits}</p>
+      </div>
+    </section>
+    <div className="gift-switch" aria-label="תצוגת החנות">
+      <Button variant={view==="gifts"?"primary":"ghost"} aria-pressed={view==="gifts"} onClick={()=>{setView("gifts");setNotice("");}}>מתנות הפתעה</Button>
+      <Button variant={view==="collection"?"primary":"ghost"} aria-pressed={view==="collection"} onClick={()=>setView("collection")}>האוסף שלי ({collection.length}/30)</Button>
+    </div>
+    {view==="gifts"?<>
+      <h2>מתנות הפתעה</h2>
+      <p className="shop-note">בחר כל קופסה שתרצה. הספרה על המטבע היא המחיר, ומה שבפנים מתגלה רק בפתיחה. אין פריטים כפולים.</p>
+      {!state.earned&&<p className="shop-note">דיוק של {CREDIT_MIN_ACCURACY}% מזכה בקרדיט אחד; מ־{DOUBLE_CREDIT_MIN_ACCURACY}% מקבלים שניים.</p>}
+      <div className="gift-switch" aria-label="סוג המתנה">
+        <Button variant={kind==="accessory"?"primary":"ghost"} aria-pressed={kind==="accessory"} onClick={()=>{setKind("accessory");setNotice("");}}>אביזרים ({gifts.filter(g=>g.kind==="accessory").length})</Button>
+        <Button variant={kind==="skin"?"primary":"ghost"} aria-pressed={kind==="skin"} onClick={()=>{setKind("skin");setNotice("");}}>סקינים ({gifts.filter(g=>g.kind==="skin").length})</Button>
+      </div>
+      <p className="gift-status" role="status">{notice}</p>
+      <div className="gift-grid">{gifts.filter(g=>g.kind===kind).map(g=><button key={g.id} className="gift-box" data-kind={g.kind} aria-label={`מתנה ${g.number}, מחיר: ${creditText(g.cost)}`} onClick={()=>{
+        const cost=g.cost;
+        if(state.credits<cost){setNotice(`לפתיחת מתנה ${g.number} צריך עוד ${creditText(cost-state.credits)}. שחק עוד סיבוב וצבור קרדיטים!`);return;}
+        setNotice("");setSelected(g.id);onOpen(g.id);
+      }}><GiftArt kind={g.kind}/><strong>מתנה {g.number}</strong><span className="gift-coin" aria-hidden="true">{g.cost}</span></button>)}</div>
+      {!gifts.some(g=>g.kind===kind)&&<p className="shop-note">פתחת את כל המתנות מהסוג הזה. הפריטים מחכים לך באוסף!</p>}
+    </>:<>
+      <h2>האוסף שלי</h2>
+      {!collection.length?<p className="shop-note">עדיין אין פריטים באוסף. פתח מתנה כדי לגלות את הפריט הראשון שלך.</p>:<div className="shop-grid">{collection.map(item=>{
+        const equipped=outfit[item.slot]===item.id;
+        return <article className="shop-card" key={item.id}><strong>{item.name}</strong><span>{equipped?"על הדמות":"באוסף שלך"}</span><Button variant={equipped?"ghost":"primary"} onClick={()=>onEquip(item)}>{equipped?"הסר":"לבש"}</Button></article>;
+      })}</div>}
+    </>}
